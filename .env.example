# Template only. Never store real secrets in Git or chat.
# Required to run the Telegram bot:
TELEGRAM_BOT_TOKEN=

# Optional until opt-in encrypted profiles are enabled. Configure both or neither.
# Put database on a mounted persistent volume.
PROFILE_DB_PATH=
PROFILE_ENCRYPTION_KEY=

# Required for real Western planetary coordinates (development setting).
# File must already exist locally; it is not automatically downloaded.
JPL_EPHEMERIS_PATH=
# Optional development-only /natal command gate (OFF by default).
# Enable only after independently verifying chart benchmarks and configuring a real local JPL kernel.
# The command has no user-data storage and does not auto-download a kernel.
ENABLE_WESTERN_NATAL=0
# Keep OFF pending external chart comparison and explicit owner approval.
WESTERN_NATAL_REVIEW_APPROVED=0

# OPTIONAL Telegram-hosted animation file_id values; text fallback works without them.
# No binary images go into SQLite.
TAROT_SHUFFLE_FILE_ID=
TAROT_REVEAL_FILE_ID=

# Optional: filesystem PATH to an existing UTF-8 JSON file, not inline JSON.
# File content: {"The Star":"TelegramPhotoFileId",...}; no media binaries.
# Preflight checks file and format before polling.
TAROT_CARD_PHOTOS_JSON=

# Telegram file_id assets only; "text" suppresses optional Tarot media entirely.
# "telegram" (default) reuses configured Telegram assets without local uploads.
TAROT_MEDIA_MODE=telegram

# Leave disabled for Render Free; ephemeral SQLite would lose birth profiles.
# ONLY set 1 after verifying a real PAID Render persistent disk mounted for
# PROFILE_DB_PATH. Confirmation is checked but cannot prove mount durability.
PROFILE_PERSISTENT_DISK_CONFIRMED=0

# Optional persistence for tiny group calendar preferences (not birth data).
# If omitted, /settings edits are RAM-only and RESET at restart.
# NEVER enable local SQLite persistence on Render Free ephemeral filesystem.
GROUP_SETTINGS_DB_PATH=
GROUP_SETTINGS_PERSISTENT_DISK_CONFIRMED=0
